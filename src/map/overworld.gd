@tool
extends GameMap

# Overworld: Terrain3D heightmap + greybox obstacle clusters, all generated by
# tools/mapgen/overworld_gen.gd (rerun it to change the layout; don't hand-edit the scene).
# Bots path on navmesh chunks the generator pre-baked (a live bake of this size would stall).
# The navigation server scans every polygon on a map for closest-point and path queries, which
# is ~20x slower here than in the gym, so lookups go through the chunk grid instead.

## Side of one pre-baked navmesh chunk (keep in sync with NAV_CHUNK in the generator).
const NAV_CHUNK := 128.0

@export var terrain: Node3D

var _camera: Camera3D
var _chunks: Dictionary[Vector2i, RID] = {}


func _ready() -> void:
	if Engine.is_editor_hint(): return
	var nav := get_node_or_null(^"Navigation")
	if nav:
		for n: Node in nav.get_children():
			var region := n as NavigationRegion3D
			if not region: continue
			var parts := String(region.name).split("_") # Chunk_<x>_<z>
			if parts.size() == 3: _chunks[Vector2i(parts[1].to_int(), parts[2].to_int())] = region.get_rid()
	use_baked_navigation()


# Terrain3D centres its detail on one camera; follow whichever is active (title orbit, player)
func _process(_delta: float) -> void:
	if Engine.is_editor_hint() or not terrain: return
	var cam := get_viewport().get_camera_3d()
	if cam and cam != _camera:
		_camera = cam
		terrain.call(&"set_camera", cam)


func ground_height(x: float, z: float) -> float:
	if not terrain: return arena_center.y
	var h: float = terrain.get(&"data").call(&"get_height", Vector3(x, 0.0, z))
	return h if is_finite(h) else arena_center.y


## Searches the chunk under p, then only the neighbours that could hold something closer.
func nav_snap(p: Vector3) -> Vector3:
	var c := _chunk_of(p)
	if not _chunks.has(c): return super(p)
	var best := NavigationServer3D.region_get_closest_point(_chunks[c], p)
	var best_d := best.distance_to(p)
	for dx: int in range(-1, 2):
		for dz: int in range(-1, 2):
			var n := c + Vector2i(dx, dz)
			if n == c or not _chunks.has(n): continue
			# horizontal distance from p to that chunk's square: nothing in it can be nearer
			var lo := Vector2(n) * NAV_CHUNK
			var nearest := Vector2(clampf(p.x, lo.x, lo.x + NAV_CHUNK), clampf(p.z, lo.y, lo.y + NAV_CHUNK))
			if nearest.distance_to(Vector2(p.x, p.z)) >= best_d: continue
			var q := NavigationServer3D.region_get_closest_point(_chunks[n], p)
			var d := q.distance_to(p)
			if d < best_d:
				best = q
				best_d = d
	return best


## Only the chunks covering the start-to-goal box, one chunk of slack around it.
func prepare_path_query(query: NavigationPathQueryParameters3D) -> void:
	if _chunks.is_empty(): return
	var a := _chunk_of(query.start_position)
	var b := _chunk_of(query.target_position)
	var regions: Array[RID] = []
	for x: int in range(mini(a.x, b.x) - 1, maxi(a.x, b.x) + 2):
		for z: int in range(mini(a.y, b.y) - 1, maxi(a.y, b.y) + 2):
			var rid: RID = _chunks.get(Vector2i(x, z), RID())
			if rid.is_valid(): regions.append(rid)
	query.included_regions = regions


func _chunk_of(p: Vector3) -> Vector2i:
	return Vector2i(floori(p.x / NAV_CHUNK), floori(p.z / NAV_CHUNK))
