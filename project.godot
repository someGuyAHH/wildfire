[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="first_person_hidden"
3d_physics/layer_1="world"
3d_physics/layer_2="characters"
3d_physics/layer_3="tag_zones"
3d_physics/layer_4="triggers"
3d_physics/layer_5="hazards"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1

[shader_globals]

game_time={
"type": "float",
"value": 0.0
}
